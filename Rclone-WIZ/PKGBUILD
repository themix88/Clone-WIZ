# Maintainer: Miran Kljun <miran.kljun@gmail.com
pkgname=rclone-wiz
pkgver=1.0.0
pkgrel=1
pkgdesc="A PyQt6 GUI tool to configure, script, and mount cloud drives using rclone."
arch=('any')
url="https://github.com/themix88/clone-wiz/Rclone-WIZ" # Update if you host it
license=('GPL3')

# --- THE IMPORTANT PART ---
# Pacman will install them automatically.
depends=(
    'python'
    'python-pyqt6'
    'rclone'
    'fuse2' # Required for the fusermount command
)

# These are optional. pacman will notify the user they exist, but won't force-install them.
optdepends=(
    'konsole: Supported terminal for rclone config'
    'alacritty: Supported terminal for rclone config'
    'gnome-terminal: Supported terminal for rclone config'
    'xterm: Supported terminal for rclone config'
)

# Tells makepkg to look for this file in the same directory
source=("rclone-wiz.py")
sha256sums=('SKIP') # Use 'SKIP' for local builds, or generate a real hash if publishing

package() {
    # This installs your python script into /usr/bin so it can be run from anywhere
    install -Dm755 "$srcdir/rclone-wiz.py" "$pkgdir/usr/bin/rclone-wiz"
}